# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase Studio > Project Settings > API
#
# A anon key é pública por natureza (vai para o navegador) — quem protege os
# dados é o RLS do db/schema.sql, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA coloque a service_role key aqui: qualquer variável NEXT_PUBLIC_ é
# embutida no bundle do navegador, e a service_role ignora todo o RLS.
